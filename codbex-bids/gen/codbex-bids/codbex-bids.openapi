components:
  schemas:
    Bid:
      type: object
      required:
      properties:
        Id:
          type: integer
          format: int32
        Name:
          type: string
          minLength: 0
          maxLength: 20
        Date:
        ValidityDate:
        Quantity:
          type: number
          format: double
        Price:
          type: number
          format: double
        Total:
          type: number
          format: double
        Offer:
          type: integer
          format: int32
        UoM:
          type: integer
          format: int32
        Product:
          type: integer
          format: int32
        CurrencyCode:
          type: string
          minLength: 0
          maxLength: 3
        Buyer:
          type: integer
          format: int32
        Trader:
          type: integer
          format: int32
        Status:
